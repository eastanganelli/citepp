{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-mingw",
      "inherits": "default",
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" }
  ]
}
